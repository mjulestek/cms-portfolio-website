generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
// MongoDB stores enums as plain strings — no changes to values needed.

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
}

enum MediaType {
  IMAGE
  ICON
  PDF
  RESUME
  AVATAR
}

enum VideoCategory {
  DEMO
  WALKTHROUGH
  ARCHITECTURE
  TUTORIAL
  TESTIMONIAL
  INTRO
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PROJECT_VIEW
  BLOG_VIEW
  VIDEO_PLAY
  RESUME_DOWNLOAD
  CONTACT_SUBMIT
  OUTBOUND_CLICK
  ADMIN_VIEW
}

// ─── NextAuth models ──────────────────────────────────────────────────────────
// Required by @next-auth/prisma-adapter. Field names and types must match
// exactly what the adapter expects. IDs use ObjectId.

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String?
  name         String?
  role         UserRole  @default(ADMIN)
  imageKey     String?
  emailVerified DateTime?
  image        String?
  accounts     Account[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Content models ───────────────────────────────────────────────────────────
// Many-to-many relationships are replaced with reference ID arrays.
// Junction tables (ProjectVideo, ProjectTech, ProjectTag, BlogPostVideo,
// BlogTag) are removed. The API layer will be updated in the next phase
// to resolve these arrays into full objects.

model Project {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  slug          String    @unique
  title         String
  tagline       String
  status        Status    @default(DRAFT)
  featured      Boolean   @default(false)
  story         String
  challenge     String
  solution      String
  results       String
  metrics       Json?
  startDate     DateTime?
  endDate       DateTime?
  githubUrl     String?
  liveUrl       String?
  coverImageKey String?
  pdfKey        String?

  // Embedded images — owned exclusively by this project
  images        ProjectImage[]

  // Reference arrays — resolved by the API layer
  // Each entry carries order + featured metadata alongside the ID
  videoEntries  ProjectVideoEntry[]
  tagIds        String[]            @db.ObjectId
  techStackIds  String[]            @db.ObjectId

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([featured])
}

// Embedded type — stored inside the Project document as an array.
// Not a separate collection. Prisma MongoDB supports embedded composite types.
type ProjectImage {
  id        String   @db.ObjectId
  s3Key     String
  alt       String?
  caption   String?
  order     Int
}

// Embedded type — stores video reference + ordering metadata inside Project.
type ProjectVideoEntry {
  videoId  String  @db.ObjectId
  order    Int
  featured Boolean
}

model BlogPost {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageKey String?
  status        Status    @default(DRAFT)
  featured      Boolean   @default(false)
  publishedAt   DateTime?

  // Reference arrays — resolved by the API layer
  videoEntries  BlogVideoEntry[]
  tagIds        String[]         @db.ObjectId

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([featured])
}

// Embedded type — stores video reference + ordering metadata inside BlogPost.
type BlogVideoEntry {
  videoId  String  @db.ObjectId
  order    Int
  featured Boolean
}

model Skill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  category    String
  iconKey     String?
  proficiency Int
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, order])
}

model Tag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model VideoAsset {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  youtubeUrl     String
  youtubeVideoId String        @unique
  title          String
  caption        String?
  category       VideoCategory
  thumbnailUrl   String
  embedUrl       String
  featured       Boolean       @default(false)
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([category, featured, order])
}

model MediaAsset {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  s3Key      String    @unique
  filename   String
  mimeType   String
  mediaType  MediaType
  size       Int
  alt        String?
  usedIn     String?
  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([mediaType, uploadedAt])
}

model Resume {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  s3Key      String   @unique
  label      String
  active     Boolean  @default(false)
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model ContactMessage {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  ipAddress String?
  userAgent String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  company   String
  avatarKey String?
  quote     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model SocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  url       String
  iconKey   String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

// Singleton document — _id is always the literal string "singleton".
// MongoDB allows custom string _id values when @db.ObjectId is NOT used.
model HomepageContent {
  id              String      @id @default("singleton") @map("_id")
  heroHeadline    String
  heroSubtext     String
  ctaText         String
  ctaUrl          String
  aboutText       String
  metaTitle       String
  metaDescription String
  featuredVideoId String?     @db.ObjectId
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model AnalyticsEvent {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  type       AnalyticsEventType
  path       String?
  referrer   String?
  userAgent  String?
  ipHash     String?
  projectId  String?            @db.ObjectId
  blogPostId String?            @db.ObjectId
  videoId    String?            @db.ObjectId
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([path])
}
